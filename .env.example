# Copy to .env and fill in. Never commit .env.
LLM_API_KEY=<ADD_YOUR_KEY_HERE>
# mock = no real LLM calls (default, safe for local dev and CI)
# openai_compatible = any provider exposing /chat/completions
LLM_PROVIDER=mock
LLM_BASE_URL=<PROVIDER_BASE_URL>
LLM_MODEL_MAIN=<model-for-tool-calling>
LLM_MODEL_FAST=<cheaper-model-for-classification-fallback>
EMBEDDING_MODEL=multilingual-e5-small
INSTITUTE_NAME=<Institute Name>
INSTITUTE_TZ=Asia/Kolkata
CLASSIFIER_THRESHOLD=0.55
ADMIN_CONTACT_NAME=<Admin Office>
ADMIN_CONTACT_EMAIL=<admin@institute.edu>
ADMIN_CONTACT_PHONE=<phone>
